@model ProductCardViewModel

<article class="card product-card h-100">
    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id">
        <img class="card-img-top product-image" src="@Model.ImagePath"
             alt="@Model.Name" loading="lazy" />
    </a>
    <div class="card-body d-flex flex-column">
        <p class="small text-secondary mb-2">@Model.Brand · @Model.Category</p>
        <h3 class="h6 mb-3">
            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id">
                @Model.Name
            </a>
        </h3>
        <div class="d-flex justify-content-between align-items-center gap-2 mt-auto">
            <strong>@Model.Price.ToString("0.00") €</strong>
            <span class="small @(Model.TotalStock > 0 ? "text-success" : "text-secondary")">
                @(Model.TotalStock > 0 ? "Налично" : "Изчерпано")
            </span>
        </div>
    </div>
</article>
